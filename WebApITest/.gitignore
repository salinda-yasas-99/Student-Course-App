## Visual Studio / .NET Core .gitignore
## Generated for ASP.NET Core projects

# Build and output directories
/bin/
/obj/

# Visual Studio temporary files, build results, and
# files generated by popular Visual Studio add-ons.
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider
.idea/

# VS Code workspace file
.vscode/
*.code-workspace

# NuGet packages
# NuGet package directory
.packages/
*.nupkg
project.lock.json
project.fragment.lock.json
artifacts/

# Dotnet publish
/publish/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Dotnet user secrets (should not be in source control)
secrets.json

# appsettings development/local files that may contain secrets
appsettings.Development.json
appsettings.Local.json

# Logs
*.log
logs/

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Rider and ReSharper
*.DotSettings.user

# Test results
TestResults/
*.trx

# Coverage
coverage.opencover.xml
coverage

# npm / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Publish output from Visual Studio
**/PublishOutput/

# Local database files
*.mdf
*.ldf
*.sqlite

# Ignore compiled Python files (if present in repo)
__pycache__/
*.pyc

# End of .gitignore
